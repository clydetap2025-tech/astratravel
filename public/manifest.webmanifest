{
  "name": "AstraTravel — Almaty",
  "short_name": "AstraTravel",
  "description": "Places, cafés and day-by-day routes for a trip to Almaty and the Almaty Region.",
  "id": "/",
  "start_url": "/#places",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0a0a0a",
  "lang": "ru",
  "categories": ["travel", "navigation"],
  "icons": [
    { "src": "/assets/astratravel.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Маршрут", "url": "/#planner" },
    { "name": "Билеты", "url": "/#tickets" },
    { "name": "Избранное", "url": "/#saved" }
  ]
}
