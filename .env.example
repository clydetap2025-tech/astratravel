# Copy to .env for local runs; on Vercel set these in Project → Settings → Environment Variables.
# Never commit real values.

# Supabase project (Settings → API). URL and anon key are public: the server hands them to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Gives back a message when OpenAI fails, powers "try without signing up" and the AI request log.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server only)
OPENAI_API_KEY=
# Model for itinerary notes; the chat model is set in the admin panel (app_settings.ai_model).
OPENAI_MODEL=gpt-5.4-nano

# Optional: salt for hashing guest IP addresses
GUEST_IP_SALT=
